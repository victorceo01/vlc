{
  "name": "stock-marketcap",
  "version": "0.1.0",
  "private": true,
  "description": "Stock Marketcap — Nigerian equity research & portfolio-intelligence platform (MVP)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @stockmc/api prisma:migrate",
    "db:seed": "pnpm --filter @stockmc/api prisma:seed",
    "db:reset": "pnpm --filter @stockmc/api prisma:reset"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
