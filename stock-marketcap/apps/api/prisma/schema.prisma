// Stock Marketcap — Prisma schema (MVP)
// Money is stored as Decimal (NGN). Prices/financials in mock data carry a
// `source` so mock data is never mistaken for live data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  FREE
  PRO
}

enum DataSource {
  mock
  live
  manual
}

enum FinancialStatementType {
  income_statement
  balance_sheet
  cash_flow
}

enum FinancialPeriod {
  annual
}

enum ConfidenceLevel {
  high
  medium
  low
  insufficient
}

enum TokenType {
  email_verification
  password_reset
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  // Null for OAuth-only accounts. Never stores plaintext.
  passwordHash  String?
  displayName   String?
  emailVerified Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  googleId      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscription   Subscription?
  watchlists     Watchlist[]
  authTokens     AuthToken[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

// Email verification + password reset tokens (single-use, hashed).
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

// Opaque refresh-token records (rotation + revocation).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Companies & securities
// ---------------------------------------------------------------------------

model Company {
  id           String   @id @default(cuid())
  name         String
  sector       String
  description  String   @default("")
  ceo          String?
  headquarters String?
  website      String?
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  securities Security[]
  financials FinancialStatement[]
  dividends  Dividend[]
  scores     StockScore[]
  news       NewsArticleCompany[]

  @@index([sector])
  @@map("companies")
}

// A tradable security (ticker). MVP has one security per company but the
// split keeps room for multiple listings later.
model Security {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  symbol        String   @unique // e.g. DANGCEM
  exchange      String   @default("NGX")
  currency      String   @default("NGN")
  listedShares  BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  currentPrice    Price?
  historicalPrices HistoricalPrice[]
  watchlistItems  WatchlistItem[]

  @@index([companyId])
  @@map("securities")
}

// Latest price snapshot (one row per security).
model Price {
  id          String     @id @default(cuid())
  securityId  String     @unique
  security    Security   @relation(fields: [securityId], references: [id], onDelete: Cascade)
  priceNgn    Decimal    @db.Decimal(18, 4)
  changePct   Decimal    @db.Decimal(9, 4) @default(0)
  volume      BigInt     @default(0)
  source      DataSource @default(mock)
  timestamp   DateTime   // observation time
  lastUpdated DateTime   @updatedAt

  @@map("prices")
}

// Historical closing prices (daily series for charts).
model HistoricalPrice {
  id         String     @id @default(cuid())
  securityId String
  security   Security   @relation(fields: [securityId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  closeNgn   Decimal    @db.Decimal(18, 4)
  volume     BigInt     @default(0)
  source     DataSource @default(mock)

  @@unique([securityId, date])
  @@index([securityId, date])
  @@map("historical_prices")
}

// ---------------------------------------------------------------------------
// Financials & dividends
// ---------------------------------------------------------------------------

// Annual financial statements. `lineItems` is a JSON map of standardized keys
// -> NGN values; `source` marks provenance (mock in MVP).
model FinancialStatement {
  id          String                 @id @default(cuid())
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        FinancialStatementType
  period      FinancialPeriod        @default(annual)
  fiscalYear  Int
  currency    String                 @default("NGN")
  lineItems   Json
  source      DataSource             @default(mock)
  timestamp   DateTime
  lastUpdated DateTime               @updatedAt

  @@unique([companyId, type, period, fiscalYear])
  @@index([companyId, type])
  @@map("financial_statements")
}

// Declared dividends only (no forecasting in MVP).
model Dividend {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear    Int
  amountPerShareNgn Decimal @db.Decimal(18, 4)
  declaredDate  DateTime?  @db.Date
  exDate        DateTime?  @db.Date
  paymentDate   DateTime?  @db.Date
  type          String     @default("final") // interim | final | special
  source        DataSource @default(mock)
  timestamp     DateTime
  lastUpdated   DateTime   @updatedAt

  @@index([companyId, fiscalYear])
  @@map("dividends")
}

// ---------------------------------------------------------------------------
// News (mock/seed articles in MVP)
// ---------------------------------------------------------------------------

model NewsArticle {
  id          String     @id @default(cuid())
  title       String
  summary     String
  body        String     @default("")
  url         String?
  sourceName  String     @default("Seed Newsroom")
  publishedAt DateTime
  source      DataSource @default(mock)
  createdAt   DateTime   @default(now())

  companies NewsArticleCompany[]

  @@index([publishedAt])
  @@map("news_articles")
}

// Join: article <-> company (and free-form sector tag).
model NewsArticleCompany {
  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([articleId, companyId])
  @@map("news_article_companies")
}

// ---------------------------------------------------------------------------
// Watchlists
// ---------------------------------------------------------------------------

model Watchlist {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  securityId  String
  security    Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, securityId])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// Subscriptions & configurable plan settings
// ---------------------------------------------------------------------------

model Subscription {
  id        String           @id @default(cuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      SubscriptionTier @default(FREE)
  // Set when a (fake, in MVP) upgrade happens. Null = no expiry / free.
  currentPeriodEnd DateTime?
  provider  String           @default("stub") // paystack | stub
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("subscriptions")
}

// Configurable pricing + entitlements per tier (no hard-coded pricing).
model PlanSetting {
  id             String           @id @default(cuid())
  tier           SubscriptionTier @unique
  displayName    String
  priceMonthlyNgn Decimal         @db.Decimal(18, 2) @default(0)
  priceYearlyNgn  Decimal         @db.Decimal(18, 2) @default(0)
  // JSON blob matching TierEntitlements in @stockmc/shared.
  entitlements   Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("plan_settings")
}

// ---------------------------------------------------------------------------
// Stock Marketcap Score (traceable)
// ---------------------------------------------------------------------------

model StockScore {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  methodVersion  String
  // Null overall score when confidence = insufficient.
  score          Decimal?        @db.Decimal(6, 2)
  confidence     ConfidenceLevel
  dataCompleteness Decimal       @db.Decimal(5, 4) @default(0)
  // Full breakdown (pillars, metrics, inputs used, weights) for traceability.
  breakdown      Json
  computedAt     DateTime        @default(now())

  @@unique([companyId, methodVersion])
  @@index([companyId])
  @@map("stock_scores")
}
