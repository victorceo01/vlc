# ---- Shared local dev env. Copy to .env and adjust. ----

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://stockmc:stockmc@localhost:5432/stockmc?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
WEB_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"

# Google OAuth (optional in dev — leave blank to disable the button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Email (dev: no SMTP — verification/reset links are logged to the API console)
MAIL_FROM="Stock Marketcap <no-reply@stockmarketcap.local>"
MAIL_TRANSPORT="console"

# Paystack (stubbed in MVP — no live billing)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYMENTS_PROVIDER="stub"

# Frontend (Next.js)
# Where the Next server proxies /api/* to (server-side). Point this at the API.
API_ORIGIN="http://localhost:4000"
# Browser API base. Leave as the same-origin path so it works through a tunnel
# or on a phone with no CORS/cookie setup. Only set an absolute URL if you host
# the API on a separate domain.
NEXT_PUBLIC_API_BASE_URL="/api/v1"
